# Normalize line endings to LF in the repository regardless of host OS.
# This project is developed on native Windows but must stay byte-identical
# when checked out on Linux (Colab / WSL / other people's machines).
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.parquet binary
*.safetensors binary
*.gguf binary

# Notebooks: diff as text but do not attempt EOL rewriting.
*.ipynb text eol=lf
